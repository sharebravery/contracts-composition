# =============================================================================
# Onchain Contract Lab - environment template
# Copy to .env.local and fill in the blanks. Never commit .env.local.
# Active chain: Arbitrum Sepolia (chainId 421614).
# =============================================================================

# ----- Frontend (NEXT_PUBLIC_, exposed to the browser) -----
NEXT_PUBLIC_DEFAULT_CHAIN_ID=421614
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Base Sepolia is not a registered chain yet.
# NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# ----- Deployer (shared by every forge script) -----
DEPLOYER_PRIVATE_KEY=
ARBITRUM_SEPOLIA_RPC_URL=

# ----- Block explorer API keys (forge verify-contract) -----
ARBISCAN_API_KEY=
# BASESCAN_API_KEY=

# ----- Treasury lab (DeployTreasury / UpgradeTreasury) -----
TREASURY_ADMIN=
TREASURY_TREASURER=
TREASURY_UPGRADE_ADMIN=
TREASURY_DAILY_LIMIT=
TREASURY_PROXY=

# ----- Reward pool lab (DeployRewardPool) -----
REWARD_FUNDING_AMOUNT=
REWARD_DURATION=

# ----- Airdrop lab (DeployAirdrop) -----
AIRDROP_MERKLE_ROOT=
AIRDROP_DEADLINE=
AIRDROP_FUNDING_AMOUNT=
